# Generated by JPrime Control Panel. Edits are overwritten when settings change; use Settings instead.
worker_processes  1;
error_log  logs/error.log warn;
pid        logs/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout  65;
    client_max_body_size 64M;
    server_tokens off;
    access_log  logs/access.log;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    upstream jprime_php {
{{UPSTREAM_SERVERS}}
    }

    server {
        listen       0.0.0.0:{{PORT}};
        server_name  _;
        root         "{{APP_PUBLIC}}";
        index        index.php index.html;
        charset      utf-8;

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        location = /favicon.ico { access_log off; log_not_found off; }
        location = /robots.txt  { access_log off; log_not_found off; }
        location = /build/manifest.json { deny all; }

        location ~* \.(?:css|js|woff2?|ttf|svg|png|jpe?g|gif|webp|ico)$ {
            expires 7d;
            add_header Cache-Control "public";
            try_files $uri =404;
        }

        # Laravel "public" disk (no storage:link junction needed)
        location /storage/ {
            alias "{{APP_STORAGE_PUBLIC}}/";
            access_log off;
        }

        location ~ \.php$ {
            try_files $uri =404;
            fastcgi_pass   jprime_php;
            fastcgi_next_upstream error timeout;
            fastcgi_read_timeout 180s;
            fastcgi_send_timeout 180s;
            fastcgi_buffers 16 16k;
            fastcgi_buffer_size 32k;
            include        fastcgi_params;
            fastcgi_param  SCRIPT_FILENAME $document_root$fastcgi_script_name;
        }

        location ~ /\.(?!well-known).* {
            deny all;
        }
    }
}
